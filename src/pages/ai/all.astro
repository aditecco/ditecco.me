---
import { ArrowLeft, ArrowUp } from "lucide-react"
import AiLayout from "../../components/AiCreations/AiLayout.astro"
import AiImg from "../../components/AiCreations/AiImg"
import { getAiCreations } from "../../lib/content"
import {
  AI_BASE,
  aiDate,
  aiHref,
  aiNumber,
  aiMediums,
  aiThings,
} from "../../lib/ai-creations"

const creations = await getAiCreations()
const mediums = aiMediums(creations)
---

<AiLayout
  title="Index · AI Creations"
  description="Every AI creation, newest first."
>
  <div class="AiPage">
    <header class="AiBar">
      <a class="AiChip" href={AI_BASE}>
        <ArrowLeft size={16} aria-hidden />
        AI Creations
      </a>
      <a class="AiLink" href="/">
        ditecco.me
      </a>
    </header>

    <section class="AiIndexHead">
      <h1>Index</h1>
      <div class="AiIndexHead-side">
        <p class="AiDeck">
          <span data-count>{aiThings(creations.length)}</span> that did not
          exist before a person and a machine sat down together.
        </p>
        {mediums.length > 1 && (
          <div
            class="AiFilters"
            role="group"
            aria-label="Filter by medium"
            hidden
          >
            <button
              type="button"
              class="AiFilter"
              data-filter=""
              aria-pressed="true"
            >
              All
            </button>
            {mediums.map(medium => (
              <button
                type="button"
                class="AiFilter"
                data-filter={medium.slug}
                aria-pressed="false"
              >
                {medium.title}
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <main>
      {creations.map((c, i) => (
        <a class="AiRow" href={aiHref(c.slug)} data-medium={c.medium?.slug}>
          <span class="AiRow-no" aria-hidden="true">
            {aiNumber(i)}
          </span>
          <span class="AiRow-text">
            <span class="AiRow-title">{c.title}</span>
            <span class="AiRow-summary">{c.summary}</span>
          </span>
          <span class="AiRow-meta">
            <span class="AiRow-medium">{c.medium?.title}</span>
            {c.tools.length > 0 && <span>{c.tools.join(" · ")}</span>}
            <span>{aiDate(c.publishedAt)}</span>
          </span>
          <AiImg
            image={c.cover}
            label="Cover · 10:7"
            className="AiRow-cover"
            width={200}
            height={140}
          />
        </a>
      ))}
      {creations.length === 0 && <p class="AiEmpty">Nothing here yet.</p>}
    </main>

    <footer class="AiFoot">
      <span>End of index</span>
      <a class="AiLink" href={AI_BASE}>
        Back to the cover
        <ArrowUp size={16} aria-hidden />
      </a>
    </footer>
  </div>
</AiLayout>

<script>
  import { aiThings } from "../../lib/ai-creations"

  const group = document.querySelector<HTMLElement>(".AiFilters")
  const rows = [...document.querySelectorAll<HTMLElement>(".AiRow")]
  const count = document.querySelector("[data-count]")

  // "" shows everything
  function apply(medium: string) {
    const buttons = [...group.querySelectorAll<HTMLElement>("[data-filter]")]
    // an unknown ?medium= falls back to All
    const active =
      buttons.find(b => b.dataset.filter === medium) ??
      buttons.find(b => b.dataset.filter === "")

    for (const b of buttons) {
      b.setAttribute("aria-pressed", String(b === active))
    }

    let shown = 0
    for (const row of rows) {
      const match =
        !active.dataset.filter || row.dataset.medium === active.dataset.filter
      row.hidden = !match
      if (match) shown++
    }
    if (count) count.textContent = aiThings(shown)

    return active.dataset.filter
  }

  // the filters only work with JS, so they stay hidden without it
  if (group) {
    group.hidden = false
    apply(new URLSearchParams(location.search).get("medium") ?? "")

    group.addEventListener("click", event => {
      const button = (event.target as Element).closest<HTMLElement>(
        "[data-filter]",
      )
      if (!button) return

      // keep the filter in the URL, so it can be shared and survives "back"
      const medium = apply(button.dataset.filter)
      const url = new URL(location.href)
      if (medium) url.searchParams.set("medium", medium)
      else url.searchParams.delete("medium")
      history.replaceState(null, "", url)
    })
  }
</script>
